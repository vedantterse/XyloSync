# Copy to .env and change the secrets. Every value has a working default,
# so `docker compose up` also works without a .env file.

APP_PORT=3000
APP_SECRET=change-me-to-a-long-random-string
# Set to true only when serving XyloSync over HTTPS.
COOKIE_SECURE=false
MAX_ROOMS_PER_USER=3
# Rooms (files, chat, members) delete themselves this many hours after creation. 0 = never.
ROOM_TTL_HOURS=8
# Log every storage event MinIO sends to the app (debugging).
LOG_WEBHOOKS=false

# MinIO object storage (console: http://localhost:9101)
MINIO_ROOT_USER=xylosync
MINIO_ROOT_PASSWORD=xylosync-secret
MINIO_BUCKET=xylosync
MINIO_CONSOLE_PORT=9101

# Shared secret MinIO uses when calling the app's storage webhook.
WEBHOOK_SECRET=change-me-webhook-secret

# Email goes to the bundled Mailpit inbox (http://localhost:8025) by default.
# Point these at your own SMTP server to deliver real email.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=XyloSync <no-reply@xylosync.local>
MAIL_INBOX_URL=http://localhost:8025
MAILPIT_PORT=8025
