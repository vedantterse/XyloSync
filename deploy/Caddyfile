# Caddy gets and renews HTTPS certificates for the domain automatically (Let's Encrypt).
# No account email: Let's Encrypt no longer sends expiry mails, and Caddy renews on its own.
# DOMAIN comes from .env through docker-compose.prod.yml.

{$DOMAIN} {
	# Compress text only. Files are left alone so downloads keep byte ranges (resume, video seeking).
	encode zstd gzip {
		match {
			header Content-Type text/*
			header Content-Type application/javascript*
			header Content-Type application/json*
			header Content-Type image/svg+xml*
		}
	}

	# A backstop for the app's own per-file limit: bigger bodies are cut off here.
	request_body {
		max_size {$MAX_FILE_MB:15}MiB
	}

	# Uploads stream straight through; WebSockets work as-is.
	reverse_proxy app:3000 {
		flush_interval -1
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
