# Caddy gets and renews HTTPS certificates for the domain automatically (Let's Encrypt).
# DOMAIN and ACME_EMAIL come from .env through docker-compose.prod.yml.
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	# Compress text only. Files are left alone so downloads keep byte ranges (resume, video seeking).
	encode zstd gzip {
		match {
			header Content-Type text/*
			header Content-Type application/javascript*
			header Content-Type application/json*
			header Content-Type image/svg+xml*
		}
	}

	# Uploads stream straight through (no size limit); WebSockets work as-is.
	reverse_proxy app:3000 {
		flush_interval -1
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
