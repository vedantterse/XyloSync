# Copy to /opt/xylosync/.env on the server and fill in every value.
# Generate secrets on the server with:  openssl rand -hex 32

# Site
DOMAIN=xylosync.in
ACME_EMAIL=you@example.com

# Set by deploy.sh on every deploy — leave as is.
IMAGE=ghcr.io/vedantterse/xylosync
IMAGE_TAG=latest

# Secrets (long random strings; changing APP_SECRET later resets everyone's identity)
APP_SECRET=
WEBHOOK_SECRET=

# Storage
MINIO_ROOT_USER=xylosync
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=xylosync

# Rooms
MAX_ROOMS_PER_USER=3
ROOM_TTL_HOURS=8

# Email. Azure blocks outgoing port 25, so use an SMTP relay on port 587
# (Brevo, Resend, Mailgun, Amazon SES, Gmail with an app password, …).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=XyloSync <files@xylosync.in>
